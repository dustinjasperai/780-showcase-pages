<script>
(function(){
  // Never phone home from an automated browser (headless / Playwright / the
  // build+verify browser). navigator.webdriver is true for all of them.
  if(navigator.webdriver){return;}
  var EP="https://780marketing.ca/api/track";
  var SLUG="debbie-reber", NAME="The Tilt, for Debbie Reber", V="teen-parenting-coach";
  var vid=Math.random().toString(36).slice(2)+Date.now().toString(36);
  function send(ev,extra){
    try{
      var p="slug="+encodeURIComponent(SLUG)+"&name="+encodeURIComponent(NAME)
        +"&v="+encodeURIComponent(V)+"&ev="+ev+"&vid="+vid+"&bv=2"+(extra||"")
        +"&ref="+encodeURIComponent(document.referrer||"")
        +"&u="+encodeURIComponent(location.href);
      var u=EP+"?"+p;
      if(navigator.sendBeacon){navigator.sendBeacon(u);}else{var i=new Image();i.src=u;}
    }catch(e){}
  }
  send("load");
  // "engaged" = 5s with the tab visible AND at least one real interaction.
  // Link scanners (Defender Safe Links etc.) render the page but don't scroll
  // or move a pointer, so they top out at "dwell" — logged, never alerted.
  var ix=false, dwell=false, engaged=false, dwellSent=false;
  function maybe(){
    if(engaged||!dwell)return;
    if(document.visibilityState!=="visible")return;
    if(ix){ engaged=true; send("engaged","&ix=1"); }
    else if(!dwellSent){ dwellSent=true; send("dwell"); }
  }
  function mark(){ if(!ix){ ix=true; maybe(); } }
  ["pointermove","pointerdown","touchstart","scroll","wheel","keydown"].forEach(function(e){
    window.addEventListener(e,mark,{once:true,passive:true,capture:true});
  });
  function arm(){ setTimeout(function(){ if(document.visibilityState==="visible"){ dwell=true; maybe(); } },5000); }
  if(document.visibilityState==="visible"){ arm(); }
  document.addEventListener("visibilitychange",function(){ if(document.visibilityState==="visible"){ arm(); } });
})();
</script>
